<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ball Rival" android:textSize="26sp" android:textStyle="bold"/>
<TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ready" android:paddingTop="8dp" android:paddingBottom="12dp"/>
<TextView android:id="@+id/countLabel" android:layout_width="match_parent" android:layout_height="wrap_content"/><SeekBar android:id="@+id/minCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="49"/><SeekBar android:id="@+id/maxCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="49"/>
<TextView android:id="@+id/sizeLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp"/><SeekBar android:id="@+id/minSize" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="280"/><SeekBar android:id="@+id/maxSize" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="280"/>
<TextView android:id="@+id/stayLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp"/><SeekBar android:id="@+id/minStay" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="29"/><SeekBar android:id="@+id/maxStay" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="29"/>
<TextView android:id="@+id/opacityLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp"/><SeekBar android:id="@+id/minOpacity" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100"/><SeekBar android:id="@+id/maxOpacity" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100"/>
<Button android:id="@+id/start" android:layout_width="match_parent" android:layout_height="56dp" android:text="Start / Apply Overlay" android:layout_marginTop="18dp"/><Button android:id="@+id/pattern" android:layout_width="match_parent" android:layout_height="56dp" android:text="New Pattern"/><Button android:id="@+id/pause" android:layout_width="match_parent" android:layout_height="56dp" android:text="Pause / Resume"/><Button android:id="@+id/stop" android:layout_width="match_parent" android:layout_height="56dp" android:text="Stop Overlay"/>
</LinearLayout></ScrollView>
